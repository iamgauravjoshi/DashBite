# Copy to .env — never commit .env
DATABASE_URL="postgresql://smartmess:smartmess_dev_pw@localhost:5432/smartmess?schema=public"
POSTGRES_PASSWORD="smartmess_dev_pw"

# Auth (better-auth). Generate a real secret for any shared environment:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="dev-only-change-me-min-32-chars-1234567890"
BETTER_AUTH_URL="http://localhost:3000"

# App defaults
APP_TIMEZONE="Asia/Kolkata"
APP_DEFAULT_CITY="Pune"

# Payments (sandbox only from Phase 5; empty in Phase 0)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
