generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 0 baseline models. Extended in Phase 2 (auth) / Phase 3 (mess).
// Timezone: store UTC (timestamptz via DateTime), interpret as Asia/Kolkata in app layer.

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum UserRole {
  CUSTOMER
  MESS_OWNER
  MESS_STAFF
  DELIVERY_AGENT
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  UNVERIFIED
}
