
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 3 mess models. Auth tables are generated by better-auth (`npx auth generate`).
// Timezone: store UTC (timestamptz via DateTime), interpret as Asia/Kolkata in app layer.

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  status        String?   @default("UNVERIFIED")
  phone         String?
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  ownedMesses   Mess[]      @relation("MessOwner")
  staffAt       MessStaff[] @relation("MessStaffMember")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  line2     String?
  locality  String
  city      String
  state     String   @default("Maharashtra")
  pincode   String
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("address")
}

enum MessVerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Mess {
  id                 String                  @id @default(cuid())
  ownerId            String
  owner              User                    @relation("MessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name               String
  slug               String                  @unique
  description        String?
  phone              String
  line1              String
  locality           String
  city               String                  @default("Pune")
  state              String                  @default("Maharashtra")
  pincode            String
  vegType            String                  @default("BOTH")
  pickupAllowed      Boolean                 @default(true)
  deliveryAllowed    Boolean                 @default(true)
  deliveryNote       String?
  serviceAreas       String[]                @default([])
  operatingDays      String[]                @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  opensAt            String                  @default("07:00")
  closesAt           String                  @default("21:00")
  verificationStatus MessVerificationStatus @default(DRAFT)
  published          Boolean                 @default(false)
  verificationReason String?
  submittedAt        DateTime?
  decidedAt          DateTime?
  decidedById        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  staff              MessStaff[]
  events             MessVerificationEvent[]

  @@index([ownerId])
  @@index([city])
  @@index([verificationStatus])
  @@map("mess")
}

model MessStaff {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessStaffMember", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messId, userId])
  @@index([userId])
  @@map("mess_staff")
}

model MessVerificationEvent {
  id        String                  @id @default(cuid())
  messId    String
  mess      Mess                    @relation(fields: [messId], references: [id], onDelete: Cascade)
  actorId   String
  from      MessVerificationStatus
  to        MessVerificationStatus
  reason    String?
  createdAt DateTime                @default(now())

  @@index([messId])
  @@map("mess_verification_event")
}
