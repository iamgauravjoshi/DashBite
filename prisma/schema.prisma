
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Phase 3 mess models. Auth tables are generated by better-auth (`npx auth generate`).
// Timezone: store UTC (timestamptz via DateTime), interpret as Asia/Kolkata in app layer.

model City {
  id        String   @id @default(cuid())
  name      String   @unique
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  status        String?   @default("UNVERIFIED")
  phone         String?
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  ownedMesses   Mess[]      @relation("MessOwner")
  staffAt       MessStaff[] @relation("MessStaffMember")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  line2     String?
  locality  String
  city      String
  state     String   @default("Maharashtra")
  pincode   String
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("address")
}

enum MessVerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model Mess {
  id                 String                  @id @default(cuid())
  ownerId            String
  owner              User                    @relation("MessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  name               String
  slug               String                  @unique
  description        String?
  phone              String
  line1              String
  locality           String
  city               String                  @default("Pune")
  state              String                  @default("Maharashtra")
  pincode            String
  vegType            String                  @default("BOTH")
  pickupAllowed      Boolean                 @default(true)
  deliveryAllowed    Boolean                 @default(true)
  deliveryNote       String?
  serviceAreas       String[]                @default([])
  operatingDays      String[]                @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
  opensAt            String                  @default("07:00")
  closesAt           String                  @default("21:00")
  verificationStatus MessVerificationStatus @default(DRAFT)
  published          Boolean                 @default(false)
  verificationReason String?
  submittedAt        DateTime?
  decidedAt          DateTime?
  decidedById        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  staff              MessStaff[]
  events             MessVerificationEvent[]
  slots              MenuSlot[]
  items              MenuItem[]
  weeklyMenus        WeeklyMenu[]
  dateMenus          DateMenu[]
  holidays           Holiday[]
  slotDays           SlotDay[]

  @@index([ownerId])
  @@index([city])
  @@index([verificationStatus])
  @@map("mess")
}

model MessStaff {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessStaffMember", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messId, userId])
  @@index([userId])
  @@map("mess_staff")
}

model MessVerificationEvent {
  id        String                  @id @default(cuid())
  messId    String
  mess      Mess                    @relation(fields: [messId], references: [id], onDelete: Cascade)
  actorId   String
  from      MessVerificationStatus
  to        MessVerificationStatus
  reason    String?
  createdAt DateTime                @default(now())

  @@index([messId])
  @@map("mess_verification_event")
}

model MenuSlot {
  id         String   @id @default(cuid())
  messId     String
  mess       Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  key        String
  name       String
  cutoffTime String   @default("09:00")
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  weekly     WeeklyMenu[]
  dateMenus  DateMenu[]
  slotDays   SlotDay[]

  @@unique([messId, key])
  @@index([messId])
  @@map("menu_slot")
}

model MenuItem {
  id          String   @id @default(cuid())
  messId      String
  mess        Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  name        String
  description String?
  pricePaise  Int
  vegType     String   @default("VEG")
  photoUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  weeklyItems WeeklyMenuItem[]
  dateItems   DateMenuItem[]

  @@index([messId])
  @@map("menu_item")
}

model WeeklyMenu {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  slotId    String
  slot      MenuSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  capacity  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     WeeklyMenuItem[]

  @@unique([messId, slotId, dayOfWeek])
  @@index([messId])
  @@map("weekly_menu")
}

model WeeklyMenuItem {
  id           String     @id @default(cuid())
  weeklyMenuId String
  weeklyMenu   WeeklyMenu @relation(fields: [weeklyMenuId], references: [id], onDelete: Cascade)
  itemId       String
  item         MenuItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  pricePaise   Int
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([weeklyMenuId, itemId])
  @@index([weeklyMenuId])
  @@map("weekly_menu_item")
}

model DateMenu {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  slotId    String
  slot      MenuSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  closed    Boolean  @default(false)
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     DateMenuItem[]

  @@unique([messId, slotId, date])
  @@index([messId, date])
  @@map("date_menu")
}

model DateMenuItem {
  id         String   @id @default(cuid())
  dateMenuId String
  dateMenu   DateMenu @relation(fields: [dateMenuId], references: [id], onDelete: Cascade)
  itemId     String
  item       MenuItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  pricePaise Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([dateMenuId, itemId])
  @@index([dateMenuId])
  @@map("date_menu_item")
}

model Holiday {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@unique([messId, date])
  @@index([messId, date])
  @@map("holiday")
}

model SlotDay {
  id        String   @id @default(cuid())
  messId    String
  mess      Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  slotId    String
  slot      MenuSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  capacity  Int
  booked    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messId, slotId, date])
  @@index([messId, date])
  @@map("slot_day")
}
